# Copy this file to ".env.local" (same folder) and fill in the values.

# --- Required: your Supabase project ---------------------------------------
# Find them in your Supabase dashboard: click the green "Connect" button at
# the top, or open Project Settings > API Keys. Use the Project URL and the
# "anon" / "publishable" key. NEVER use the "service_role" or "secret" key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: email the seller when a buyer sends a message -----------------
# Without these, messages are still saved in Supabase; the seller just isn't
# emailed. Create a free account at https://resend.com and make an API key.
# This one is a real SECRET: it has no NEXT_PUBLIC_ in its name on purpose, so it
# stays on the server and never reaches the browser.
RESEND_API_KEY=
# Who the email is "from". Leave this empty to use Resend's test address
# (onboarding@resend.dev), which can only deliver to the email address you
# signed up to Resend with. To email any seller, verify a domain you own in
# Resend and set this to something like: Marketplace <hello@your-domain.com>
EMAIL_FROM=
