# Copy this file to ".env.local" (same folder) and fill in the values.

# --- Required: your Supabase project ---------------------------------------
# Find them in your Supabase dashboard: click the green "Connect" button at
# the top, or open Project Settings > API Keys. Use the Project URL and the
# "anon" / "publishable" key for these two (never the "secret" key here: these
# values are visible in the browser). The secret key goes in its own server-only
# setting further down.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: email the seller when a buyer sends a message -----------------
# Without these, messages are still saved in Supabase; the seller just isn't
# emailed. Create a free account at https://resend.com and make an API key.
# This one is a real SECRET: it has no NEXT_PUBLIC_ in its name on purpose, so it
# stays on the server and never reaches the browser.
RESEND_API_KEY=
# Who the email is "from". Leave this empty to use Resend's test address
# (onboarding@resend.dev), which can only deliver to the email address you
# signed up to Resend with. To email any seller, verify a domain you own in
# Resend and set this to something like: Marketplace <hello@your-domain.com>
EMAIL_FROM=

# --- Test 4: payments with Stripe Connect (Stripe's TEST mode only) -----------
# Use Stripe's sandbox keys. The secret key (sk_test_...) is a real SECRET: never
# commit it and never put NEXT_PUBLIC_ in front of it.
STRIPE_SECRET_KEY=
# The browser-safe key. The hosted Checkout page does not need it, but it is safe to keep.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The webhook's signing secret (whsec_...), printed once by scripts/create-webhook.mjs.
STRIPE_WEBHOOK_SECRET=
# Supabase's SECRET key (Project Settings > API Keys > "secret"). It ignores the
# database's safety rules, so it is for SERVER code only: never put NEXT_PUBLIC_ in
# front of it, never commit it. Our Stripe routes use it to save sellers and orders
# and to mark listings as sold.
SUPABASE_SERVICE_ROLE_KEY=
